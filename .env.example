# ─── Application ──────────────────────────────────────────
APP_ENV=development
SECRET_KEY=changeme-supersecret-key-in-production
DEBUG=true

# ─── Database (PostgreSQL) ────────────────────────────────
POSTGRES_USER=querymind
POSTGRES_PASSWORD=querymind_dev_password
POSTGRES_DB=querymind_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Constructed DATABASE_URL (used by SQLAlchemy / Alembic)
DATABASE_URL=postgresql://querymind:querymind_dev_password@db:5432/querymind_db

# ─── Backend ──────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ─── Chroma (Vector DB) ───────────────────────────────────
# CHROMA_HOST/CHROMA_PORT are what the *backend* dials. In docker-compose the
# backend is given CHROMA_HOST=chroma and CHROMA_PORT=8000 (the in-network port);
# CHROMA_PORT below is also the host port published by compose (8001 -> 8000).
CHROMA_HOST=chroma
CHROMA_PORT=8001

# ─── LLM ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-placeholder
# Google Gemini API key (Google AI Studio) — required for question generation
GEMINI_API_KEY=your-gemini-api-key
# Gemini model id (see https://ai.google.dev/gemini-api/docs/models).
# Default is a "lite" model: the free tier gives it the most generous quota and
# it is fast for the short, structured JSON we ask for. Avoid a quota-limited
# `gemini-*-flash` model here unless you have billing enabled.
LLM_MODEL=gemini-flash-lite-latest
# Optional ordered fallback models (comma-separated). When LLM_MODEL (or
# LLM_EVAL_MODEL) returns a quota error (429 / RESOURCE_EXHAUSTED) or keeps
# returning 503 after the built-in retries, the request is retried against the
# next model here instead of failing. Empty = single-model behaviour.
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview

# ─── LLM thinking / output ─────────────────────────────────
# Lowest thinking level the configured model supports. Generation and scoring
# emit short JSON and need no deep reasoning, so `low` is the default — it is
# the lowest level accepted across the Gemini 3 family (some models reject
# `minimal`). Models that do support `minimal` (e.g. gemini-3.5-flash-lite) can
# opt in. For Gemini 2.5 models use LLM_THINKING_BUDGET instead.
LLM_THINKING_LEVEL=low
# Hard cap on output tokens per LLM call; thinking tokens count toward it.
LLM_MAX_OUTPUT_TOKENS=2048

# ─── LLM reliability ───────────────────────────────────────
# Hard per-call timeout (seconds); a slower call is retried, then fails 503.
LLM_TIMEOUT_SECONDS=45
# Max simultaneous Gemini calls per backend process.
LLM_MAX_CONCURRENCY=3

# ─── Startup warm-up ───────────────────────────────────────
# When true the backend pre-loads the embedding model, Chroma collection and
# structured-output schemas during startup so the first request is fast. Set to
# false to start instantly (the first request then pays that one-time cost).
WARMUP_ON_STARTUP=true

# ─── Retrieval cache ───────────────────────────────────────
# In-memory TTL (seconds) and max entries for cached retrieval results.
RETRIEVAL_CACHE_TTL_SECONDS=300
RETRIEVAL_CACHE_MAX_ENTRIES=256
