# ─── Application ──────────────────────────────────────────
APP_ENV=development
SECRET_KEY=changeme-supersecret-key-in-production
DEBUG=true

# ─── Database (PostgreSQL) ────────────────────────────────
POSTGRES_USER=querymind
POSTGRES_PASSWORD=querymind_dev_password
POSTGRES_DB=querymind_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Constructed DATABASE_URL (used by SQLAlchemy / Alembic)
DATABASE_URL=postgresql://querymind:querymind_dev_password@db:5432/querymind_db

# ─── Backend ──────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ─── Chroma (Vector DB) ───────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8001

# ─── LLM (stub — real key added when integrating AI layer) ─
OPENAI_API_KEY=sk-placeholder
