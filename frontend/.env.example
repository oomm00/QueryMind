# QueryMind Frontend Environment Variables

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Master Toggle: set to true to force ALL endpoints to use mocks
VITE_USE_MOCKS=false

# ── Granular Per-Endpoint Mock Switches ─────────────────────────────
# Set to 'true' to mock a specific domain, or 'false' to call real backend.
# Real calls for auth by default:
VITE_MOCK_AUTH=false

# Mocked by default per project foundation setup:
VITE_MOCK_QUESTIONS=false
VITE_MOCK_ATTEMPTS=false
VITE_MOCK_DOCUMENTS=false
VITE_MOCK_PROFILE_GOAL=true
VITE_MOCK_NEXT_PARAMS=true
VITE_MOCK_PROFILE=false
VITE_MOCK_HISTORY=false
