# ── Python bytecode & caches ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtualenv ────────────────────────────────────────────
# Dependencies are installed in the image from requirements.txt; never ship a
# host virtualenv (hundreds of MB and host-specific).
venv/
.venv/
env/

# ── Local state & secrets — never bake these into an image ─
.env
*.db
*.db-journal
*.sqlite
*.sqlite3
chroma_data/

# ── Tooling / editor / VCS ────────────────────────────────
.git/
.gitignore
.vscode/
.idea/
*.log
